# Turkish kelimle - Environment Variables
# Copy this to .env and fill in your values

# Supabase Configuration (Turkish database - separate from Arabic!)
SUPABASE_URL=your_turkish_supabase_url
SUPABASE_KEY=your_turkish_supabase_anon_key
SUPABASE_SERVICE_KEY=your_turkish_supabase_service_key

# Admin Configuration
ADMIN_SECRET=change-me-in-production

# App Configuration
DEBUG=false
